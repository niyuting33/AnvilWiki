---
import { Icon } from 'astro-icon/components';
import LazyYouTube from '~/components/video/LazyYouTube.astro';
import { getCategoryVideo } from '~/config/category-videos';
import type { Locale } from '~/i18n/routing';

interface Props {
  category: string;
  locale: Locale;
}

const { category, locale } = Astro.props;
const video = getCategoryVideo(category, locale);
const copy = video?.copy[locale];
---

{
  video && copy && (
    <section
      class="overflow-hidden rounded-2xl border border-border bg-card/90 shadow-sm"
      aria-labelledby={`${category}-video-title`}
    >
      <div class="grid gap-0 lg:grid-cols-[minmax(0,1.35fr)_minmax(20rem,0.65fr)]">
        <div class="p-4 sm:p-6">
          <LazyYouTube videoId={video.videoId} title={copy.title} />
        </div>
        <div class="flex flex-col justify-center border-t border-border p-6 lg:border-l lg:border-t-0">
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-nav">{copy.eyebrow}</p>
          <h2 id={`${category}-video-title`} class="mt-2 text-2xl font-bold tracking-tight">
            {copy.title}
          </h2>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">{copy.description}</p>
          <div class="mt-4 rounded-lg border border-nav/20 bg-nav/5 p-3 text-sm leading-6">
            <span class="font-semibold">{locale === 'zh' ? '观看重点：' : 'Watch for: '}</span>
            <span class="text-foreground/80">{copy.watchFor}</span>
          </div>
          <p class="mt-3 flex items-start gap-2 text-xs leading-5 text-muted-foreground">
            <Icon name="lucide:badge-info" class="mt-0.5 h-4 w-4 shrink-0 text-nav" />
            <span>{copy.versionNote}</span>
          </p>
          <a
            href={video.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-nav hover:underline"
          >
            {copy.sourceLabel}
            <Icon name="lucide:external-link" class="h-3.5 w-3.5" />
          </a>
        </div>
      </div>
    </section>
  )
}
