---
import SkillsDirectory from '~/components/database/SkillsDirectory.astro';
import LocaleLayout from '~/components/layout/LocaleLayout.astro';
import CategoryVideo from '~/components/video/CategoryVideo.astro';
import { defaultLocale } from '~/i18n/routing';

const title = 'Emberville Skills Database — Classes & Abilities';
const description =
  'Search Emberville skills by class, active or passive type, and verification status. Demo-only abilities are clearly marked and exact unverified values are omitted.';
---

<LocaleLayout locale={defaultLocale} {title} {description} availableLocales={[defaultLocale]}>
  <header class="mx-auto max-w-4xl text-center">
    <p class="text-sm font-bold uppercase tracking-[0.2em] text-nav">Version-aware database</p>
    <h1 class="mt-3 text-4xl font-black tracking-tight md:text-5xl">Emberville Skills</h1>
    <p class="mt-4 text-base leading-7 text-muted-foreground md:text-lg">
      Emberville skills belong to combat classes and can contribute to custom fighting styles
      through the game's inheritance system. This directory separates official system facts from
      version-sensitive demo observations.
    </p>
  </header>

  <div class="mt-10">
    <SkillsDirectory />
  </div>

  <div class="mt-10"><CategoryVideo category="skills" locale={defaultLocale} /></div>

  <nav class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-label="Related Emberville pages">
    <a
      class="rounded-xl border bg-card p-4 font-semibold transition hover:border-nav hover:text-nav"
      href="/classes/">Explore Classes</a
    >
    <a
      class="rounded-xl border bg-card p-4 font-semibold transition hover:border-nav hover:text-nav"
      href="/mechanics/">Understand Mechanics</a
    >
    <a
      class="rounded-xl border bg-card p-4 font-semibold transition hover:border-nav hover:text-nav"
      href="/guides/beginner-guide/">Read Beginner Guide</a
    >
    <a
      class="rounded-xl border bg-card p-4 font-semibold transition hover:border-nav hover:text-nav"
      href="/bosses/">Study Bosses</a
    >
  </nav>
</LocaleLayout>
